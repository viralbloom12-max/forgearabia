# Site
NEXT_PUBLIC_SITE_URL=https://forgearabia.com

# Google Analytics 4 (optional). Set your Measurement ID to enable GA4 and
# conversion tracking (generate_lead, whatsapp_click, phone_click, cta_click).
# When unset, no analytics script loads. No fake IDs are shipped.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification (optional).
# Paste only the token value from the "HTML tag" method. When unset, no
# verification meta tag is emitted. DNS/HTML-file verification also works
# and needs nothing here.
# GOOGLE_SITE_VERIFICATION=

# Lead notification email (Resend).
# The contact form posts to /api/lead, which emails the enquiry. Until
# RESEND_API_KEY is set the API returns a delivery error and the form
# prompts the visitor to use WhatsApp instead, so nothing breaks.
# RESEND_API_KEY=re_xxxxxxxx
# Where leads are delivered (defaults to info@forgearabia.com).
# LEAD_TO_EMAIL=info@forgearabia.com
# Verified sender in your Resend account. The domain must be verified,
# or Resend will reject the send.
# LEAD_FROM_EMAIL=Forge Arabia <leads@forgearabia.com>
